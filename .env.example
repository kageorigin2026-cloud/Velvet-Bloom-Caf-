# ==============================================================
# VELVET BLOOM CAFÉ V2 — ENVIRONMENT CONFIGURATION
# ==============================================================

# Data Adapter Mode: 'local' (local development adapter) or 'supabase' (live Supabase PostgreSQL)
DATA_ADAPTER=local

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Default Tenant Configuration
# - For DATA_ADAPTER=local: 'tenant-velvet-bloom-01'
# - For DATA_ADAPTER=supabase: '00000000-0000-0000-0000-000000000001' (seeded tenant UUID)
DEFAULT_TENANT_ID=tenant-velvet-bloom-01
DEFAULT_TENANT_SLUG=velvet-bloom

# --------------------------------------------------------------
# SUPABASE CONFIGURATION (Required when DATA_ADAPTER=supabase)
# --------------------------------------------------------------
# Obtain these from your Supabase Dashboard: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only secret key (Required for trusted backend operations, NEVER expose with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# JWT Secret for Auth Token Verification (Optional server-side)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
